{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Only the emulator commands are exposed to the mobile window.",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "permissions": [
    "allow-reset",
    "allow-load-demo",
    "allow-load-monitor2-rom",
    "allow-load-program",
    "allow-key-event",
    "allow-run",
    "allow-snapshot",
    "allow-framebuffer",
    "allow-read-memory"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Only the emulator commands are exposed to the desktop window.",
  "windows": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "permissions": [
    "allow-reset",
    "allow-load-demo",
    "allow-load-program",
    "allow-run",
    "allow-snapshot",
    "allow-framebuffer",
    "allow-read-memory"
  ]
}
